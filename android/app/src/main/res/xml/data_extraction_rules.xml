<?xml version="1.0" encoding="utf-8"?>
<!-- Las claves y los chats viven solo en el dispositivo: no van al backup en la nube ni a
     otro telefono por transferencia. Para mudarse se usa el respaldo cifrado o la vinculacion. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
