JWT_SECRET=change-me-in-production
PORT=4900
CLIENT_ORIGIN=http://localhost:5900

# Postgres local
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=otpchat
PGMAINTENANCE_DATABASE=postgres

# Alternativa para Neon/Render:
# DATABASE_URL=postgresql://user:password@host:5432/otpchat
# PGSSL=true

# Crea/actualiza tablas automáticamente en desarrollo.
PG_CREATE_DATABASE=true
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# Para pruebas queda apagado. Cambiar a true para recuperar el cooldown de 24 h.
REGISTER_COOLDOWN_ENABLED=false

# Para pruebas queda apagado. Cambiar a true para volver a "un dispositivo = una cuenta".
DEVICE_ACCOUNT_LIMIT_ENABLED=false

# Web Push / VAPID. Generar con: node -e "const webpush=require('web-push'); console.log(webpush.generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
