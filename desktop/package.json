{
  "name": "otpchat-desktop",
  "version": "2.0.0",
  "description": "OTPChat para escritorio: nodo propio con la ventana excluida de capturas de pantalla.",
  "main": "main.cjs",
  "private": true,
  "author": "Fuster Microsystems",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.fustermicrosystems.otpchat.desktop",
    "productName": "OTPChat",
    "files": ["main.cjs", "preload.cjs", "app/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "portable", "artifactName": "otpchat-windows.exe" }
  }
}
